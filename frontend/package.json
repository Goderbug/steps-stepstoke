{
  "name": "cto-relay-station-w1",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "CTO Relay Station: W1 Chinese interface integrated with the A1 browser SDK and actual local contracts; public deployment closed.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium webkit",
    "check": "npm run typecheck && npm run test:unit && npm run build && npm run test:e2e",
    "local:setup": "node scripts/local-setup.mjs",
    "test:local": "node tests/integration/browser-chain.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.5",
    "dompurify": "3.4.17",
    "ethers": "6.17.0",
    "marked": "18.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "viem": "2.57.7",
    "wagmi": "3.7.7",
    "@coinbase/wallet-sdk": "4.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
